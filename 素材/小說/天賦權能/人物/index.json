      ]
    },
    { "id": "character-007", "name": "希拉",
      "tags": ["亞特家"],
      "summary": "亞特家的二管家，身材有些胖的中年女性。",
      "content": "從小照顧迪亞，因此與迪亞的關係很好。",
      "initialStatus": "locked",
      "unlockHint": "完成第三章解鎖。",
