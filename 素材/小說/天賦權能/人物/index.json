    { "id": "character-001", "name": "艾迪．亞特",
      "tags": ["亞特家", "主角", "2000期生"],
      "portrait": "../人物/艾迪_亞特.png",
      "summary": "亞特家族的長子。",
      "content": "出生於亞特家族的長子，因為天生魔力低下，在貴族圈中被蔑視著。但在如今卻有著遠超常人的實力。",
      "sections": []
    },
    { "id": "character-002", "name": "迪亞．亞特",
      "tags": ["亞特家", "主角", "2000期生"],
      "summary": "亞特家族的次子，樂觀、單純、善良。",
      "content": "覺醒的天賦為冰魔法。對著大哥艾迪抱著崇拜、尊敬的感情。"
    },
    { "id": "character-003", "name": "亞娜．亞特",
      "tags": ["亞特家", "主角", "2000期生"],
      "summary": "亞特家族的三女，天才少女。",
      "content": "天賦為沉默與一個未公開的天賦。極高的智慧使其在幼年參與家族的各種決策，如今已掌握了許多的產業。",
      "sections": [
        { "id": "character-003-A", "title": "個性",
          "content": "是天才少女，對待外人有禮得體，但對於熟識的人，會顯現出有些腹黑的一面。",
          "initialStatus": "locked",
          "unlockHint": "完成第五章解鎖。",
          "unlockAfter": ["holy-land-005"]
        }
      ]
    },
    { "id": "character-004", "name": "亞特．哈希",
      "tags": ["亞特家", "1982期生"],
      "summary": "副城貴族。",
      "content": "位於王城西方，奇洛斯派系的一員。是艾迪、迪亞、亞娜的父親。有著出色的能力，於11歲時便進入了聖地。",
      "links": [
        {"type": "characters", "id": "character-001", "label": "艾迪"},
        {"type": "characters", "id": "character-002", "label": "迪亞"},
        {"type": "characters", "id": "character-003", "label": "亞娜"}
      ]
    },
    { "id": "character-005", "name": "潘特．英列",
      "tags": ["亞特家", "1982期生"],
      "summary": "亞特的夫人。",
      "content": "於聖地時便與亞特為好友。",
      "links": [
        {"type": "characters", "id": "character-004", "label": "亞特"}
      ]
    },   
    { "id": "character-006", "name": "瑟夫",
      "tags": ["亞特家"],
      "summary": "亞特家的大管家，白髮的優雅老人。",
      "content": "重視禮儀與規則的人，也是家主亞特最信任的人。",
      "initialStatus": "locked",
      "unlockHint": "完成第二章解鎖。",
      "unlockAfter": ["holy-land-002"],
      "links":[
