    { "id": "character-016", "name": "羅格",
      "tags": ["聖地", "???"],
      "summary": "觸發創作者。",
      "content": "製作【觸發】魔道具、虛擬世界的主導研究員。另外在資訊加密、區塊連結網的優化理論，也影響了深遠。最後於創作魔道具時死亡。",
      "initialStatus": "locked",
      "unlockAfter": ["holy-land-008"],
      "sections": [
        { "id": "character-016-a", "title": "身世",
          "content": "約五百年前被紮克研發的召喚魔術呼叫的異世界人。",
          "initialStatus": "locked",
